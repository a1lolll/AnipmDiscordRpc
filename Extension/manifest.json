{
  "manifest_version": 3,
  "name": "AniPm - Discord Rich Presence",
  "description": "Syncs your active anime watch status from Ani.pm directly to your Discord profile.",
  "version": "1.0",
  "permissions": ["storage", "tabs"],
  "icons": {
    "16": "SSlogo.png",
    "48": "SSlogo.png",
    "128": "SSlogo.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "SSlogo.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-anipm.js"],
      "all_frames": true
    }
  ]
}